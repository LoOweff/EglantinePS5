diff --git a/src/shader_recompiler/profile.h b/src/shader_recompiler/profile.h
index 68b0509..8a21462 100644
--- a/src/shader_recompiler/profile.h
+++ b/src/shader_recompiler/profile.h
@@ -81,6 +81,10 @@ struct Profile {
 
     /// OpFClamp is broken and OpFMax + OpFMin should be used instead
     bool has_broken_spirv_clamp{};
+    /// Emit float min/max/clamp/saturate with GLSL.std.450 NMin/NMax. Maxwell's FMNMX returns the
+    /// operand that is not NaN and saturation turns NaN into 0; FMin/FMax/FClamp leave NaN
+    /// undefined, and AMD drivers return it, which bloom and accumulation then spread over the frame.
+    bool need_nan_safe_min_max{};
     /// The Position builtin needs to be wrapped in a struct when used as an input
     bool has_broken_spirv_position_input{};
     /// Offset image operands with an unsigned type do not work
diff --git a/src/shader_recompiler/backend/spirv/emit_spirv_floating_point.cpp b/src/shader_recompiler/backend/spirv/emit_spirv_floating_point.cpp
index d921913..74b6e7d 100644
--- a/src/shader_recompiler/backend/spirv/emit_spirv_floating_point.cpp
+++ b/src/shader_recompiler/backend/spirv/emit_spirv_floating_point.cpp
@@ -18,6 +18,10 @@ Id Decorate(EmitContext& ctx, IR::Inst* inst, Id op) {
 }
 
 Id Clamp(EmitContext& ctx, Id type, Id value, Id zero, Id one) {
+    if (ctx.profile.need_nan_safe_min_max) {
+        // NaN becomes the lower bound (0 for saturation), as on Maxwell.
+        return ctx.OpNMin(type, ctx.OpNMax(type, value, zero), one);
+    }
     if (ctx.profile.has_broken_spirv_clamp) {
         return ctx.OpFMin(type, ctx.OpFMax(type, value, zero), one);
     } else {
@@ -85,18 +89,30 @@ Id EmitFPFma64(EmitContext& ctx, IR::Inst* inst, Id a, Id b, Id c) {
 }
 
 Id EmitFPMax32(EmitContext& ctx, Id a, Id b) {
+    if (ctx.profile.need_nan_safe_min_max) {
+        return ctx.OpNMax(ctx.F32[1], a, b);
+    }
     return ctx.OpFMax(ctx.F32[1], a, b);
 }
 
 Id EmitFPMax64(EmitContext& ctx, Id a, Id b) {
+    if (ctx.profile.need_nan_safe_min_max) {
+        return ctx.OpNMax(ctx.F64[1], a, b);
+    }
     return ctx.OpFMax(ctx.F64[1], a, b);
 }
 
 Id EmitFPMin32(EmitContext& ctx, Id a, Id b) {
+    if (ctx.profile.need_nan_safe_min_max) {
+        return ctx.OpNMin(ctx.F32[1], a, b);
+    }
     return ctx.OpFMin(ctx.F32[1], a, b);
 }
 
 Id EmitFPMin64(EmitContext& ctx, Id a, Id b) {
+    if (ctx.profile.need_nan_safe_min_max) {
+        return ctx.OpNMin(ctx.F64[1], a, b);
+    }
     return ctx.OpFMin(ctx.F64[1], a, b);
 }
 
